--ESQUEMA RELACIONAL
-- Tabela "Mãe"
CREATE TABLE Pessoa (
    id_pessoa SERIAL PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    rua VARCHAR(100),
    cidade VARCHAR(50),
    cep VARCHAR(10)
);

-- Tabela para atributo multivalorado (1 Pessoa tem N Telefones)
CREATE TABLE Telefone (
    id_telefone SERIAL PRIMARY KEY,
    id_pessoa INT REFERENCES Pessoa(id_pessoa) ON DELETE CASCADE,
    numero VARCHAR(15)
);

-- Tabela "Filha" (Relação 1:1 com Pessoa)
CREATE TABLE Professor (
    id_pessoa INT PRIMARY KEY REFERENCES Pessoa(id_pessoa) ON DELETE CASCADE,
    salario DECIMAL(10, 2),
    titulacao VARCHAR(20) CHECK (titulacao IN ('ESPECIALISTA', 'MESTRE', 'DOUTOR'))
);

-- Tabela "Filha" (Relação 1:1 com Pessoa)
CREATE TABLE Aluno (
    id_pessoa INT PRIMARY KEY REFERENCES Pessoa(id_pessoa) ON DELETE CASCADE,
    matricula VARCHAR(20) UNIQUE NOT NULL
);

